# Copier en .env.local (non versionné) pour le développement, ou saisir dans Vercel ▸ Settings ▸ Environment Variables.
# Connexion Postgres Neon (ajoutée automatiquement par l'intégration Neon de Vercel).
DATABASE_URL=postgres://utilisateur:motdepasse@hote.neon.tech/neondb?sslmode=require
# Mot de passe d'accès au CRM.
APP_PASSWORD=choisir-un-mot-de-passe-long
# Optionnel : clé de signature des sessions.
# SESSION_SECRET=
